@inherits LayoutComponentBase

<div class="app">
    <header class="kopf">
        <img src="icon-192.png" alt="" class="kopf-icon" />
        <span class="kopf-titel">Triple A</span>
    </header>

    <main class="inhalt">
        @Body
    </main>

    <nav class="reiter">
        <NavLink href="" Match="NavLinkMatch.All" class="reiter-link">
            <svg viewBox="0 0 24 24" class="reiter-icon" aria-hidden="true">
                <path d="M14 3v9a4 4 0 1 1-8 0v-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                <path d="M6 11l-2 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                <circle cx="14" cy="3" r="1.5" fill="currentColor" />
            </svg>
            <span>Fischen</span>
        </NavLink>
        <NavLink href="tiere" Match="NavLinkMatch.Prefix" class="reiter-link">
            <svg viewBox="0 0 24 24" class="reiter-icon" aria-hidden="true">
                <path d="M2 12c3-4 8-5 12-3l6-3-2 6 2 6-6-3c-4 2-9 1-12-3z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                <circle cx="7" cy="11" r="1" fill="currentColor" />
            </svg>
            <span>Tiere</span>
        </NavLink>
    </nav>
</div>
