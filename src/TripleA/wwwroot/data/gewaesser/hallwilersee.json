{
  "id": "hallwilersee",
  "name": "Hallwilersee",
  "typ": "See",
  "kantone": [
    "ag",
    "lu"
  ],
  "zugang": "Gültige Fischereikarte des Kantons Aargau oder Fischereipatent des Kantons Luzern, ab 10 Jahren mit Sachkundenachweis (SaNa). Kinder bis Ende des 11. Altersjahres brauchen in Begleitung einer berechtigten Person keine Karte. Karte bzw. Patent mitführen (ohne Foto zusätzlich einen amtlichen Ausweis).",
  "erfasst": true,
  "nurVerweis": false,
  "verweis": null,
  "hinweise": [
    {
      "text": "Fischen ist auch nachts erlaubt.",
      "quelle": {
        "titel": "Übereinkunft Hallwilersee, § 9 Abs. 1",
        "url": "https://www.ag.ch/media/kanton-aargau/bvu/umwelt-natur/fischerei/fischerkarten-(bestellungen)/uebereinkunft-hallwilersee-2021.pdf",
        "stand": "2022-01-01"
      }
    },
    {
      "text": "Fänge in der Fangstatistik erfassen (zuständig ist der Kanton Aargau).",
      "quelle": {
        "titel": "Übereinkunft Hallwilersee, § 4 Abs. 1",
        "url": "https://www.ag.ch/media/kanton-aargau/bvu/umwelt-natur/fischerei/fischerkarten-(bestellungen)/uebereinkunft-hallwilersee-2021.pdf",
        "stand": "2022-01-01"
      }
    },
    {
      "text": "Fangverbote und Schutzzonen richten sich nach kommunalem, kantonalem und eidgenössischem Recht.",
      "quelle": {
        "titel": "Übereinkunft Hallwilersee, § 14",
        "url": "https://www.ag.ch/media/kanton-aargau/bvu/umwelt-natur/fischerei/fischerkarten-(bestellungen)/uebereinkunft-hallwilersee-2021.pdf",
        "stand": "2022-01-01"
      }
    },
    {
      "text": "Für Arten ohne Regel in der Übereinkunft gelten die Vorschriften des jeweiligen Kantons.",
      "quelle": {
        "titel": "Übereinkunft Hallwilersee, § 1",
        "url": "https://www.ag.ch/media/kanton-aargau/bvu/umwelt-natur/fischerei/fischerkarten-(bestellungen)/uebereinkunft-hallwilersee-2021.pdf",
        "stand": "2022-01-01"
      }
    }
  ],
  "koederRegeln": [
    {
      "text": "Angel- und Schleppfischerei ganzjährig mit höchstens zwei Ruten bzw. zwei Schnüren mit je höchstens fünf Angeln (einfache Angel oder Dreiangel).",
      "quelle": {
        "titel": "Übereinkunft Hallwilersee, § 8",
        "url": "https://www.ag.ch/media/kanton-aargau/bvu/umwelt-natur/fischerei/fischerkarten-(bestellungen)/uebereinkunft-hallwilersee-2021.pdf",
        "stand": "2022-01-01"
      }
    },
    {
      "text": "Lebende Köderfische sind verboten. Erlaubt sind nur tote Köderfische nicht geschützter Arten aus dem Hallwilersee, die ein allfälliges Mindestmass erfüllen.",
      "quelle": {
        "titel": "Übereinkunft Hallwilersee, § 6",
        "url": "https://www.ag.ch/media/kanton-aargau/bvu/umwelt-natur/fischerei/fischerkarten-(bestellungen)/uebereinkunft-hallwilersee-2021.pdf",
        "stand": "2022-01-01"
      }
    },
    {
      "text": "Vom 26. Dezember bis 1. Mai beim Schleppangeln und Spinnfischen vom Boot mindestens 150 m Abstand zum Ufer.",
      "quelle": {
        "titel": "Übereinkunft Hallwilersee, § 7 Abs. 1",
        "url": "https://www.ag.ch/media/kanton-aargau/bvu/umwelt-natur/fischerei/fischerkarten-(bestellungen)/uebereinkunft-hallwilersee-2021.pdf",
        "stand": "2022-01-01"
      }
    }
  ],
